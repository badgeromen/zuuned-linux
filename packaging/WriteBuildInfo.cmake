cmake_minimum_required(VERSION 3.21)
foreach(_required SOURCE_DIR OUTPUT_DIR PROJECT_VERSION_VALUE QT_VERSION_VALUE)
    if(NOT DEFINED ${_required})
        message(FATAL_ERROR "Missing ${_required}")
    endif()
endforeach()
find_program(_zuuned_git git)
# git -C inside an unpacked submodule must not identify its parent repository.
function(is_git_root directory out)
    execute_process(COMMAND "${_zuuned_git}" -C "${directory}" rev-parse --show-toplevel
        OUTPUT_VARIABLE _top OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    file(REAL_PATH "${directory}" _directory)
    if(_top STREQUAL _directory)
        set(${out} TRUE PARENT_SCOPE)
    else()
        set(${out} FALSE PARENT_SCOPE)
    endif()
endfunction()
function(source_revision directory prefix supplied_revision supplied_dirty)
    if(NOT supplied_revision STREQUAL "")
        string(LENGTH "${supplied_revision}" _length)
        if(NOT supplied_revision MATCHES "^[a-f0-9]+$" OR NOT _length EQUAL 40)
            message(FATAL_ERROR "${prefix} archive revision must be a full 40-character Git hash")
        endif()
        string(SUBSTRING "${supplied_revision}" 0 12 _id)
        if(supplied_dirty STREQUAL "true")
            set(_dirty true)
            string(APPEND _id "+dirty")
        elseif(supplied_dirty STREQUAL "false")
            set(_dirty false)
        elseif(supplied_dirty STREQUAL "")
            set(_dirty null)
            string(APPEND _id "+state-unknown")
        else()
            message(FATAL_ERROR "${prefix} archive dirty state must be true, false, or unset")
        endif()
        set(${prefix}_SHA "${supplied_revision}" PARENT_SCOPE)
        set(${prefix}_ID "${_id}" PARENT_SCOPE)
        set(${prefix}_DIRTY "${_dirty}" PARENT_SCOPE)
        return()
    endif()
    is_git_root("${directory}" _is_root)
    if(NOT _is_root)
        set(${prefix}_SHA "unknown" PARENT_SCOPE)
        set(${prefix}_ID "unknown" PARENT_SCOPE)
        set(${prefix}_DIRTY "null" PARENT_SCOPE)
        return()
    endif()
    execute_process(COMMAND "${_zuuned_git}" -C "${directory}" rev-parse HEAD
        OUTPUT_VARIABLE _sha OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${_zuuned_git}" -C "${directory}" status --porcelain
        --untracked-files=normal --ignore-submodules=none
        OUTPUT_VARIABLE _status OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    string(SUBSTRING "${_sha}" 0 12 _id)
    set(_dirty false)
    if(NOT _status STREQUAL "")
        string(APPEND _id "+dirty")
        set(_dirty true)
    endif()
    set(${prefix}_SHA "${_sha}" PARENT_SCOPE)
    set(${prefix}_ID "${_id}" PARENT_SCOPE)
    set(${prefix}_DIRTY "${_dirty}" PARENT_SCOPE)
endfunction()
# The branch shown beside a revision. Archive builds name it explicitly, as
# they do the revision, and Git is never asked; a checkout reads its own, and a
# detached HEAD (a fresh submodule checkout) names none. Names go into a C
# string and JSON, so only ordinary ref characters are accepted.
function(source_branch directory prefix supplied_revision supplied_branch)
    set(_safe "^[A-Za-z0-9._/+-]+$")
    set(${prefix}_BRANCH "" PARENT_SCOPE)
    if(NOT supplied_revision STREQUAL "")
        if(NOT supplied_branch STREQUAL "")
            if(NOT supplied_branch MATCHES "${_safe}")
                message(FATAL_ERROR "${prefix} archive branch may use only letters, digits and . _ / + -")
            endif()
            set(${prefix}_BRANCH "${supplied_branch}" PARENT_SCOPE)
        endif()
        return()
    endif()
    if(NOT supplied_branch STREQUAL "")
        message(FATAL_ERROR "${prefix} archive branch needs the archive revision as well")
    endif()
    is_git_root("${directory}" _is_root)
    if(NOT _is_root)
        return()
    endif()
    execute_process(COMMAND "${_zuuned_git}" -C "${directory}" symbolic-ref --quiet --short HEAD
        OUTPUT_VARIABLE _branch OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE _result)
    if(_result EQUAL 0 AND _branch MATCHES "${_safe}")
        set(${prefix}_BRANCH "${_branch}" PARENT_SCOPE)
    endif()
endfunction()
source_revision("${SOURCE_DIR}" APP "${ZUUNED_SOURCE_REVISION}" "${ZUUNED_SOURCE_DIRTY}")
source_revision("${SOURCE_DIR}/libzune" LIBZUNE "${ZUUNED_LIBZUNE_REVISION}" "${ZUUNED_LIBZUNE_DIRTY}")
source_branch("${SOURCE_DIR}" APP "${ZUUNED_SOURCE_REVISION}" "${ZUUNED_SOURCE_BRANCH}")
source_branch("${SOURCE_DIR}/libzune" LIBZUNE "${ZUUNED_LIBZUNE_REVISION}" "${ZUUNED_LIBZUNE_BRANCH}")
# libzune's release version, from the macros its own Makefile reads.
set(LIBZUNE_VERSION "")
if(EXISTS "${SOURCE_DIR}/libzune/include/zune.h")
    file(STRINGS "${SOURCE_DIR}/libzune/include/zune.h" _zune_lines
        REGEX "^#define LIBZUNE_VERSION_(MAJOR|MINOR|PATCH) [0-9]+$")
    set(_parts "")
    foreach(_part MAJOR MINOR PATCH)
        set(_found "")
        foreach(_line IN LISTS _zune_lines)
            if(_line MATCHES "^#define LIBZUNE_VERSION_${_part} ([0-9]+)$")
                set(_found "${CMAKE_MATCH_1}")
            endif()
        endforeach()
        if(NOT _found STREQUAL "")
            list(APPEND _parts "${_found}")
        endif()
    endforeach()
    list(LENGTH _parts _count)
    if(_count EQUAL 3)
        list(JOIN _parts "." LIBZUNE_VERSION)
    endif()
endif()
# "branch @ revision", or the revision alone when no branch is known.
function(identity out branch id)
    if(branch STREQUAL "")
        set(${out} "${id}" PARENT_SCOPE)
    else()
        set(${out} "${branch} @ ${id}" PARENT_SCOPE)
    endif()
endfunction()
function(json_text out value)
    if(value STREQUAL "")
        set(${out} "null" PARENT_SCOPE)
    else()
        set(${out} "\"${value}\"" PARENT_SCOPE)
    endif()
endfunction()
identity(_app_identity "${APP_BRANCH}" "${APP_ID}")
identity(_libzune_identity "${LIBZUNE_BRANCH}" "${LIBZUNE_ID}")
if(NOT LIBZUNE_VERSION STREQUAL "")
    set(_libzune_identity "${LIBZUNE_VERSION}, ${_libzune_identity}")
endif()
set(_version "${PROJECT_VERSION_VALUE} (${_app_identity}; libzune ${_libzune_identity})")
json_text(_app_branch_json "${APP_BRANCH}")
json_text(_libzune_branch_json "${LIBZUNE_BRANCH}")
json_text(_libzune_version_json "${LIBZUNE_VERSION}")
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(_header "#pragma once\nnamespace ZuunedBuild {\ninline constexpr char version[] = \"${_version}\";\ninline constexpr char appRevision[] = \"${APP_SHA}\";\ninline constexpr char libzuneRevision[] = \"${LIBZUNE_SHA}\";\n}\n")
set(_json "{\n  \"version\": \"${PROJECT_VERSION_VALUE}\",\n  \"application\": \"${APP_SHA}\",\n  \"applicationDirty\": ${APP_DIRTY},\n  \"applicationBranch\": ${_app_branch_json},\n  \"libzune\": \"${LIBZUNE_SHA}\",\n  \"libzuneDirty\": ${LIBZUNE_DIRTY},\n  \"libzuneBranch\": ${_libzune_branch_json},\n  \"libzuneVersion\": ${_libzune_version_json},\n  \"qtBuildVersion\": \"${QT_VERSION_VALUE}\"\n}\n")
file(WRITE "${OUTPUT_DIR}/ZuunedBuildInfo.h.tmp" "${_header}")
file(WRITE "${OUTPUT_DIR}/zuuned-build.json.tmp" "${_json}")
configure_file("${OUTPUT_DIR}/ZuunedBuildInfo.h.tmp" "${OUTPUT_DIR}/ZuunedBuildInfo.h" COPYONLY)
configure_file("${OUTPUT_DIR}/zuuned-build.json.tmp" "${OUTPUT_DIR}/zuuned-build.json" COPYONLY)
file(REMOVE "${OUTPUT_DIR}/ZuunedBuildInfo.h.tmp" "${OUTPUT_DIR}/zuuned-build.json.tmp")
